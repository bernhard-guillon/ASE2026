	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_neural_ops.dir/build.make CMakeFiles/test_neural_ops.dir/utest/test_neural_ops.cpp.i
.PHONY : utest/test_neural_ops.cpp.i

utest/test_neural_ops.s: utest/test_neural_ops.cpp.s
.PHONY : utest/test_neural_ops.s

# target to generate assembly for a file
utest/test_neural_ops.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_neural_ops.dir/build.make CMakeFiles/test_neural_ops.dir/utest/test_neural_ops.cpp.s
.PHONY : utest/test_neural_ops.cpp.s

